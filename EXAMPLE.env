# ==============================================================================
# Spike Environment Configuration Template (Alpine-Based Standalone Testing)
# ==============================================================================

# Base Alpine Version
ALPINE_VERSION=3.20

# ------------------------------------------------------------------------------
# User & Group Mapping Configurations
# ------------------------------------------------------------------------------

# Default simulates fixed vendor/runtime UID (e.g. 1824)
DEV_UID=1824
DEV_GID=1824

# Scenario 1: Windows with Rancher Desktop (H_W_0R)
# Keep default DEV_UID=1824 or set to 1000

# Scenario 2: macOS with Rancher Desktop (H_M_0R)
# Keep default DEV_UID=1824 or set to $(id -u)

# Scenario 3: Void Linux with Rootless Docker (L_M_0U)
# Keep default DEV_UID=1824 to observe subordinate drift, or set to $(id -u)
